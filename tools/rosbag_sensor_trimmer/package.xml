<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rosbag_sensor_trimmer</name>
  <version>0.1.0</version>
  <description>Direct serialized-message rosbag2 trimming, statistics, and integrity validation for LiDAR and IMU data.</description>
  <maintainer email="136431507+Aldoubt@users.noreply.github.com">Xuan Yang</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>qtbase5-dev</build_depend>
  <build_depend>libqt5opengl5-dev</build_depend>

  <depend>rosbag2_cpp</depend>
  <depend>rosbag2_transport</depend>
  <depend>rosbag2_storage</depend>
  <depend>rosbag2_compression</depend>
  <depend>rosbag2_compression_zstd</depend>
  <depend>rclcpp</depend>
  <depend>livox_ros_driver2</depend>
  <depend>rosgraph_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_msgs</depend>
  <exec_depend>qtbase5-dev</exec_depend>
  <exec_depend>libqt5opengl5-dev</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosbag2_storage_default_plugins</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
