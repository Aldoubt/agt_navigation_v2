<?xml version="1.0"?>
<sdf version="1.8">
  <world name="agt_agri_validation">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>30 20</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 20</size></plane></geometry>
          <material><diffuse>0.35 0.32 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Four simple crop rows. These are geometric test fixtures, not a photorealistic field. -->
    <model name="crop_row_north_outer"><static>true</static><pose>0 3 0.45 0 0 0</pose><link name="row"><collision name="c"><geometry><box><size>16 0.5 0.9</size></box></geometry></collision><visual name="v"><geometry><box><size>16 0.5 0.9</size></box></geometry><material><diffuse>0.12 0.42 0.12 1</diffuse></material></visual></link></model>
    <model name="crop_row_north_inner"><static>true</static><pose>0 1 0.45 0 0 0</pose><link name="row"><collision name="c"><geometry><box><size>16 0.5 0.9</size></box></geometry></collision><visual name="v"><geometry><box><size>16 0.5 0.9</size></box></geometry><material><diffuse>0.12 0.42 0.12 1</diffuse></material></visual></link></model>
    <model name="crop_row_south_inner"><static>true</static><pose>0 -1 0.45 0 0 0</pose><link name="row"><collision name="c"><geometry><box><size>16 0.5 0.9</size></box></geometry></collision><visual name="v"><geometry><box><size>16 0.5 0.9</size></box></geometry><material><diffuse>0.12 0.42 0.12 1</diffuse></material></visual></link></model>
    <model name="crop_row_south_outer"><static>true</static><pose>0 -3 0.45 0 0 0</pose><link name="row"><collision name="c"><geometry><box><size>16 0.5 0.9</size></box></geometry></collision><visual name="v"><geometry><box><size>16 0.5 0.9</size></box></geometry><material><diffuse>0.12 0.42 0.12 1</diffuse></material></visual></link></model>

    <model name="fixed_obstacle"><static>true</static><pose>4 0 0.4 0 0 0</pose><link name="box"><collision name="c"><geometry><box><size>0.7 0.7 0.8</size></box></geometry></collision><visual name="v"><geometry><box><size>0.7 0.7 0.8</size></box></geometry><material><diffuse>0.55 0.15 0.10 1</diffuse></material></visual></link></model>

    <model name="headland_marker"><static>true</static><pose>7 4.2 0.25 0 0 0</pose><link name="box"><collision name="c"><geometry><box><size>1.0 1.0 0.5</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 1.0 0.5</size></box></geometry><material><diffuse>0.15 0.25 0.65 1</diffuse></material></visual></link></model>

    <include>
      <uri>model://bunker_sim</uri>
      <name>bunker_sim</name>
      <pose>-7 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
