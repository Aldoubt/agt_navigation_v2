<?xml version="1.0"?>
<sdf version="1.8">
  <model name="bunker_sim" canonical_link="base_link">
    <!-- SOFTWARE_ONLY proxy. Do not treat these dynamics as field acceptance. -->
    <pose>0 0 0 0 0 0</pose>

    <link name="base_link">
      <pose>0 0 0.34 0 0 0</pose>
      <inertial>
        <mass>100.0</mass>
        <inertia>
          <ixx>8.0</ixx><iyy>10.0</iyy><izz>12.0</izz>
          <ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>1.023 0.778 0.26</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>1.023 0.778 0.26</size></box></geometry>
        <material><diffuse>0.18 0.22 0.20 1</diffuse></material>
      </visual>
    </link>

    <link name="front_left_wheel">
      <pose>0.34 0.40 0.14 1.57079632679 0 0</pose>
      <inertial><mass>4.0</mass><inertia><ixx>0.04</ixx><iyy>0.04</iyy><izz>0.04</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry></visual>
    </link>
    <link name="rear_left_wheel">
      <pose>-0.34 0.40 0.14 1.57079632679 0 0</pose>
      <inertial><mass>4.0</mass><inertia><ixx>0.04</ixx><iyy>0.04</iyy><izz>0.04</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry></visual>
    </link>
    <link name="front_right_wheel">
      <pose>0.34 -0.40 0.14 1.57079632679 0 0</pose>
      <inertial><mass>4.0</mass><inertia><ixx>0.04</ixx><iyy>0.04</iyy><izz>0.04</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry></visual>
    </link>
    <link name="rear_right_wheel">
      <pose>-0.34 -0.40 0.14 1.57079632679 0 0</pose>
      <inertial><mass>4.0</mass><inertia><ixx>0.04</ixx><iyy>0.04</iyy><izz>0.04</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry></visual>
    </link>

    <joint name="front_left_joint" type="revolute">
      <parent>base_link</parent><child>front_left_wheel</child><axis><xyz>0 1 0</xyz></axis>
    </joint>
    <joint name="rear_left_joint" type="revolute">
      <parent>base_link</parent><child>rear_left_wheel</child><axis><xyz>0 1 0</xyz></axis>
    </joint>
    <joint name="front_right_joint" type="revolute">
      <parent>base_link</parent><child>front_right_wheel</child><axis><xyz>0 1 0</xyz></axis>
    </joint>
    <joint name="rear_right_joint" type="revolute">
      <parent>base_link</parent><child>rear_right_wheel</child><axis><xyz>0 1 0</xyz></axis>
    </joint>

    <link name="lidar_link">
      <pose>0.10 0 0.62 0 0 0</pose>
      <visual name="visual"><geometry><cylinder><radius>0.055</radius><length>0.07</length></cylinder></geometry></visual>
      <sensor name="navigation_lidar" type="gpu_lidar">
        <topic>/simulation/bunker/scan</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples><resolution>1</resolution>
              <min_angle>-3.14159265359</min_angle><max_angle>3.14159265359</max_angle>
            </horizontal>
          </scan>
          <range><min>0.10</min><max>30.0</max><resolution>0.02</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </lidar>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="lidar_fixed_joint" type="fixed"><parent>base_link</parent><child>lidar_link</child></joint>

    <link name="imu_link">
      <pose>0 0 0.48 0 0 0</pose>
      <sensor name="navigation_imu" type="imu">
        <topic>/simulation/bunker/imu</topic>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
      </sensor>
    </link>
    <joint name="imu_fixed_joint" type="fixed"><parent>base_link</parent><child>imu_link</child></joint>

    <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>front_left_joint</left_joint>
      <left_joint>rear_left_joint</left_joint>
      <right_joint>front_right_joint</right_joint>
      <right_joint>rear_right_joint</right_joint>
      <wheel_separation>0.80</wheel_separation>
      <wheel_radius>0.14</wheel_radius>
      <topic>/model/bunker_sim/cmd_vel</topic>
      <odom_topic>/model/bunker_sim/odometry</odom_topic>
      <tf_topic>/model/bunker_sim/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_acceleration>0.8</max_linear_acceleration>
      <max_angular_acceleration>1.0</max_angular_acceleration>
    </plugin>

    <plugin filename="libignition-gazebo-joint-state-publisher-system.so" name="ignition::gazebo::systems::JointStatePublisher"/>
  </model>
</sdf>
