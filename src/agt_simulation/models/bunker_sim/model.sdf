<?xml version="1.0"?>
<sdf version="1.8">
  <model name="bunker_sim" canonical_link="base_link">
    <!-- SOFTWARE_ONLY proxy. Do not treat these dynamics as field acceptance. -->
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>

    <link name="base_link">
      <pose relative_to="__model__">0 0 0.34 0 0 0</pose>
      <inertial>
        <mass>100.0</mass>
        <inertia>
          <ixx>8.0</ixx><iyy>10.0</iyy><izz>12.0</izz>
          <ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>1.023 0.778 0.26</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>1.023 0.778 0.26</size></box></geometry>
        <material><diffuse>0.18 0.22 0.20 1</diffuse></material>
      </visual>
      <!-- Visible mounting block so the LiDAR is physically attached in Gazebo. -->
      <visual name="lidar_mount_visual">
        <pose>0.10 0 0.145 0 0 0</pose>
        <geometry><box><size>0.08 0.08 0.03</size></box></geometry>
        <material><diffuse>0.10 0.10 0.10 1</diffuse></material>
      </visual>
    </link>

    <!-- Wheel poses are explicitly relative to base_link. Joint axes are expressed
         in the model frame, following the Fortress SDF robot examples. -->
    <link name="front_left_wheel">
      <pose relative_to="base_link">0.34 0.40 -0.20 -1.57079632679 0 0</pose>
      <inertial><mass>4.0</mass><inertia><ixx>0.04</ixx><iyy>0.04</iyy><izz>0.04</izz></inertia></inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2><slip1>0.02</slip1><slip2>0.02</slip2></ode></friction></surface>
      </collision>
      <visual name="visual"><geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry><material><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
    </link>
    <link name="rear_left_wheel">
      <pose relative_to="base_link">-0.34 0.40 -0.20 -1.57079632679 0 0</pose>
      <inertial><mass>4.0</mass><inertia><ixx>0.04</ixx><iyy>0.04</iyy><izz>0.04</izz></inertia></inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2><slip1>0.02</slip1><slip2>0.02</slip2></ode></friction></surface>
      </collision>
      <visual name="visual"><geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry><material><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
    </link>
    <link name="front_right_wheel">
      <pose relative_to="base_link">0.34 -0.40 -0.20 -1.57079632679 0 0</pose>
      <inertial><mass>4.0</mass><inertia><ixx>0.04</ixx><iyy>0.04</iyy><izz>0.04</izz></inertia></inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2><slip1>0.02</slip1><slip2>0.02</slip2></ode></friction></surface>
      </collision>
      <visual name="visual"><geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry><material><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
    </link>
    <link name="rear_right_wheel">
      <pose relative_to="base_link">-0.34 -0.40 -0.20 -1.57079632679 0 0</pose>
      <inertial><mass>4.0</mass><inertia><ixx>0.04</ixx><iyy>0.04</iyy><izz>0.04</izz></inertia></inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2><slip1>0.02</slip1><slip2>0.02</slip2></ode></friction></surface>
      </collision>
      <visual name="visual"><geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry><material><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
    </link>

    <joint name="front_left_joint" type="revolute">
      <pose relative_to="front_left_wheel"/>
      <parent>base_link</parent><child>front_left_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit></axis>
    </joint>
    <joint name="rear_left_joint" type="revolute">
      <pose relative_to="rear_left_wheel"/>
      <parent>base_link</parent><child>rear_left_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit></axis>
    </joint>
    <joint name="front_right_joint" type="revolute">
      <pose relative_to="front_right_wheel"/>
      <parent>base_link</parent><child>front_right_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit></axis>
    </joint>
    <joint name="rear_right_joint" type="revolute">
      <pose relative_to="rear_right_wheel"/>
      <parent>base_link</parent><child>rear_right_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit></axis>
    </joint>

    <link name="lidar_link">
      <pose relative_to="base_link">0.10 0 0.195 0 0 0</pose>
      <visual name="visual">
        <geometry><cylinder><radius>0.055</radius><length>0.07</length></cylinder></geometry>
        <material><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
      <sensor name="navigation_lidar" type="gpu_lidar">
        <topic>/simulation/bunker/scan</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples><resolution>1</resolution>
              <min_angle>-3.14159265359</min_angle><max_angle>3.14159265359</max_angle>
            </horizontal>
          </scan>
          <range><min>0.10</min><max>30.0</max><resolution>0.02</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </lidar>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="lidar_fixed_joint" type="fixed"><parent>base_link</parent><child>lidar_link</child></joint>

    <link name="imu_link">
      <pose relative_to="base_link">0 0 0.08 0 0 0</pose>
      <sensor name="navigation_imu" type="imu">
        <topic>/simulation/bunker/imu</topic>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
      </sensor>
    </link>
    <joint name="imu_fixed_joint" type="fixed"><parent>base_link</parent><child>imu_link</child></joint>

    <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>front_left_joint</left_joint>
      <left_joint>rear_left_joint</left_joint>
      <right_joint>front_right_joint</right_joint>
      <right_joint>rear_right_joint</right_joint>
      <wheel_separation>0.80</wheel_separation>
      <wheel_radius>0.14</wheel_radius>
      <topic>/model/bunker_sim/cmd_vel</topic>
      <odom_topic>/model/bunker_sim/odometry</odom_topic>
      <tf_topic>/model/bunker_sim/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_acceleration>0.8</max_linear_acceleration>
      <max_angular_acceleration>1.0</max_angular_acceleration>
    </plugin>

    <!-- Physics-derived truth is separate from DiffDrive wheel odometry. The
         acceptance smoke uses it to catch wheel-spin / no-chassis-motion cases. -->
    <plugin filename="libignition-gazebo-odometry-publisher-system.so" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>30</odom_publish_frequency>
      <odom_topic>/model/bunker_sim/ground_truth</odom_topic>
      <tf_topic>/model/bunker_sim/ground_truth_tf</tf_topic>
      <dimensions>2</dimensions>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>

    <plugin filename="libignition-gazebo-joint-state-publisher-system.so" name="ignition::gazebo::systems::JointStatePublisher"/>
  </model>
</sdf>
